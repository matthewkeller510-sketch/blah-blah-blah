{
  "name": "catacombs-untitled",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "$className": "ReplicatedStorage"
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "$className": "ServerScriptService"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "$className": "StarterPlayerScripts"
      },
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CharacterWalkSpeed": 11,
        "EnableMouseLockOption": false
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/character"
      },
      "$className": "StarterPlayer"
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      },
      "$className": "Players"
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "$className": "Workspace"
    }
  }
}
